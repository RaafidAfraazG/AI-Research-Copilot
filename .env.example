# =============================================================================
# AI Research Copilot — Environment Variables Template
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------
APP_ENV=development                    # development | staging | production
APP_DEBUG=true
APP_LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -----------------------------------------------------------------------------
# LLM PROVIDER
# -----------------------------------------------------------------------------
# Choose one: gemini | ollama | openai | anthropic | mock
# gemini = free-tier cloud LLM (recommended for local dev without GPU)
# mock   = offline deterministic provider (for testing without any API key)
LLM_PROVIDER=gemini

# --- Google Gemini (free-tier, PRIMARY provider) ---
# Get a free API key at: https://aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite    # validated Free Tier model; use any model available to your key

# --- Paid-provider safety guard ---
# Set to false (default) to block accidentally using paid providers (OpenAI, Anthropic).
# Gemini free-tier and Mock are always allowed regardless of this setting.
LLM_ALLOW_PAID_PROVIDER=false

# --- OpenAI (if LLM_PROVIDER=openai, requires LLM_ALLOW_PAID_PROVIDER=true) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini               # gpt-4o | gpt-4o-mini | gpt-3.5-turbo

# --- Anthropic (if LLM_PROVIDER=anthropic, requires LLM_ALLOW_PAID_PROVIDER=true) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-haiku-20240307  # claude-3-5-sonnet-20241022 | claude-3-haiku-20240307

# --- Ollama (if LLM_PROVIDER=ollama, local GPU/CPU inference) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2                  # Run: ollama pull llama3.2

# LLM generation settings
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# -----------------------------------------------------------------------------
# EMBEDDING MODEL
# -----------------------------------------------------------------------------
# Provider: local (sentence-transformers) | openai
# local = sentence-transformers (real). mock = deterministic hash vectors, ONLY for
# tests/experiments; it is never selected automatically if the real model fails to load.
EMBEDDING_PROVIDER=local

# Local sentence-transformers model name
# all-MiniLM-L6-v2     → 384-dim, fast, ~22MB (default, good for dev)
# all-mpnet-base-v2    → 768-dim, higher quality, ~420MB (Phase 8 option)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# OpenAI embeddings (if EMBEDDING_PROVIDER=openai)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# -----------------------------------------------------------------------------
# DATA ROOT (indexes, corpus, backups) — independent of the working directory
# -----------------------------------------------------------------------------
# Default: <repo>/data. Relative values resolve against the repository root.
# DATA_DIR=data

# -----------------------------------------------------------------------------
# POSTGRESQL — Application Metadata Database
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=copilot_user
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ai_research_copilot

# Full connection URL (auto-constructed if not set explicitly)
# DATABASE_URL=postgresql+asyncpg://copilot_user:password@localhost:5432/ai_research_copilot

# -----------------------------------------------------------------------------
# OPENSEARCH — Lexical / BM25 Search
# -----------------------------------------------------------------------------
OPENSEARCH_HOST=localhost
OPENSEARCH_PORT=9200
OPENSEARCH_USER=admin
OPENSEARCH_PASSWORD=change_me_in_production
OPENSEARCH_USE_SSL=false
OPENSEARCH_INDEX_NAME=documents

# -----------------------------------------------------------------------------
# QDRANT — Vector / Dense Search
# -----------------------------------------------------------------------------
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=                      # Only needed for Qdrant Cloud
QDRANT_COLLECTION_NAME=document_chunks

# -----------------------------------------------------------------------------
# REDIS — Cache & Celery Broker
# -----------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # Leave empty for local dev without auth
REDIS_DB=0

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Query result cache TTL (seconds)
CACHE_TTL_SECONDS=3600

# -----------------------------------------------------------------------------
# RETRIEVAL PIPELINE & RERANKING
# -----------------------------------------------------------------------------
# Number of candidates fetched from each retriever before fusion
RETRIEVAL_BM25_TOP_N=30
RETRIEVAL_DENSE_TOP_N=30
RETRIEVAL_TOP_K=10
RRF_K=60

# Cross-Encoder Reranker Settings
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANKER_DEVICE=cpu                     # cpu | cuda
RERANKER_MAX_LENGTH=512
RERANKER_BATCH_SIZE=16
RERANKER_CANDIDATE_K=25
RERANKER_FALLBACK_MODE=hybrid_score     # hybrid_score | error

# Evidence Selection Settings
EVIDENCE_TOP_K=6
EVIDENCE_MIN_SCORE=                     # Optional minimum score threshold (leave empty for none)
EVIDENCE_MAX_PER_DOCUMENT=2             # Maximum passages from the same document (diversity control)
EVIDENCE_SIMILARITY_THRESHOLD=0.85      # Near-duplicate passage suppression threshold

# Passage chunking settings
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=50

# -----------------------------------------------------------------------------
# QUERY INTELLIGENCE & DECOMPOSITION
# -----------------------------------------------------------------------------
ENABLE_DECOMPOSITION=true
DECOMPOSITION_MODE=auto                # auto | llm | deterministic
MAX_SUBQUERIES=5
MAX_TOTAL_EVIDENCE=12
MAX_EVIDENCE_PER_SUBQUERY=4

# -----------------------------------------------------------------------------

# SOURCE CONNECTORS
# -----------------------------------------------------------------------------
# arXiv — no API key needed
ARXIV_MAX_RESULTS=10
ARXIV_ENABLED=true

# Semantic Scholar — free tier, optional API key for higher limits
SEMANTIC_SCHOLAR_API_KEY=
SEMANTIC_SCHOLAR_MAX_RESULTS=10
SEMANTIC_SCHOLAR_ENABLED=true

# Web fetcher — generic URL content extraction
WEB_FETCHER_ENABLED=true
WEB_FETCHER_TIMEOUT_SECONDS=10

# GitHub connector — optional, requires PAT for higher rate limits
GITHUB_TOKEN=
GITHUB_ENABLED=false

# -----------------------------------------------------------------------------
# READINESS
# -----------------------------------------------------------------------------
# /ready checks only what the local architecture needs: PostgreSQL, the active index
# (integrity + embedding compatibility) and LLM configuration. OpenSearch/Qdrant-server/Redis
# are reported as "skipped". Set true to probe them informationally (never causes 503).
# READINESS_PROBE_OPTIONAL=false

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# -----------------------------------------------------------------------------
# SECURITY (Production only)
# -----------------------------------------------------------------------------
# API key for protecting the backend (optional)
# API_SECRET_KEY=

# Secret key for session signing
SECRET_KEY=change_me_to_a_random_secret_in_production
