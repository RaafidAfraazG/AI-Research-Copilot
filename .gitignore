# =============================================================================
# AI Research Copilot — .gitignore
# =============================================================================
# Source code, tests, migrations, scripts, lockfiles, corpus files, benchmark
# datasets and evaluation reports are version-controlled. Secrets, local
# indexes, backups, caches and build output are not.

# -----------------------------------------------------------------------------
# Secrets — never commit real credentials
# -----------------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
secrets/

# -----------------------------------------------------------------------------
# Python
# -----------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
build/
dist/
wheels/
*.whl

# Virtual environments
.venv/
venv/
ENV/
env/

# Test / lint / type-check caches
.pytest_cache/
.coverage
coverage.xml
htmlcov/
.hypothesis/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# -----------------------------------------------------------------------------
# Node / frontend
# -----------------------------------------------------------------------------
node_modules/
dist-ssr/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# -----------------------------------------------------------------------------
# Editors and OS-generated files
# -----------------------------------------------------------------------------
.idea/
.vscode/
*.iml
*.swp
*.swo
*~
.DS_Store
._*
Thumbs.db
ehthumbs.db
desktop.ini
.claude/settings.local.json

# -----------------------------------------------------------------------------
# Logs and temporary files
# -----------------------------------------------------------------------------
*.log
logs/
*.tmp
*.temp
*.bak
.scratch/
scratch/

# -----------------------------------------------------------------------------
# Model weights and downloaded caches (re-downloaded automatically)
# -----------------------------------------------------------------------------
/models/
.cache/
huggingface/
*.bin
*.pt
*.pth
*.ckpt
*.safetensors

# -----------------------------------------------------------------------------
# Local data stores and generated artifacts
# -----------------------------------------------------------------------------
# Tracked: data/corpus/, data/evaluation/, data/*.json (sources and benchmark
# datasets), reports/evaluation/ (evidence). Not tracked: everything that
# `scripts/index_admin.py` can regenerate or that holds local machine state.
data/indexes/
data/backups/
data/opensearch_local/
data/qdrant_local/
backend/data/
.lock

# Output of the reproduction command in the README
reports/evaluation/repro/
